# The weather API as it is published from app/. Build context: app/
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ENV DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1
WORKDIR /src
COPY global.json* ./
COPY src ./src
RUN dotnet publish src/Weather.Api -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0
ENV DOTNET_EnableDiagnostics=0 ASPNETCORE_URLS=http://+:5080
WORKDIR /app
COPY --from=build /out ./
# The database lives in a volume, owned by the user the application runs as.
RUN mkdir /data && chown app:app /data
USER app
EXPOSE 5080
ENTRYPOINT ["dotnet", "Weather.Api.dll"]
