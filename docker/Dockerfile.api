# The shop API (app/api). Build context: app/.
FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 DB_PATH=/data/shop.db PORT=5080
WORKDIR /app
COPY api/server.py ./
# The database lives in a volume, owned by the user the application runs as.
RUN useradd --system --uid 10001 app && mkdir /data && chown app /data
USER app
EXPOSE 5080
ENTRYPOINT ["python", "server.py"]
