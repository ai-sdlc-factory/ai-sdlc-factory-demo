# Copy of what ./setup.sh writes to demo/.env (never commit that file). Everything has a default except the secrets, which setup generates.
DEMO_REPO=valters/weather
DEMO_BRANCH=main
WEATHER_VERSION=local
WEATHER_API_PORT=5080
WEATHER_WEB_PORT=8081
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_PASSWORD=
ALERT_INTAKE_TOKEN=
ALERT_INTAKE_DRY_RUN=true
ALERT_INTAKE_MAX_TICKETS_PER_HOUR=6
ALERT_INTAKE_GROUP_MINUTES=15
# ./setup.sh fills these two from FACTORY_HOSTS in deploy/.env: the bot's token on the first Forgejo (the scripts fetch the source with it), and the
# hosts the alert intake may open tickets on (its own list, ALERT_INTAKE_HOSTS: no webhook secrets, and no tokens until ./setup.sh --create-tickets).
FORGEJO_BOT_TOKEN=
ALERT_INTAKE_HOSTS=
