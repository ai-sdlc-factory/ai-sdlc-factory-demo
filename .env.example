# Copy of what ./setup.sh writes to .env (never commit that file). Everything has a default except the secrets, which setup generates.
WEATHER_VERSION=local
WEATHER_API_PORT=5080
WEATHER_WEB_PORT=8081
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_PASSWORD=
ALERT_INTAKE_TOKEN=
ALERT_INTAKE_DRY_RUN=true
ALERT_INTAKE_MAX_TICKETS_PER_HOUR=6
ALERT_INTAKE_GROUP_MINUTES=15
# Where the alert intake opens tickets. Only needed for real tickets (./setup.sh --create-tickets); a dry run just logs them.
#   DEMO_GIT_TYPE  forgejo (the default) or github
#   DEMO_GIT_URL   as the intake's container reaches it: https://github.com, or your Forgejo (a Forgejo on this machine: http://host.docker.internal:3000)
#   DEMO_REPO      owner/name of the repository that receives the tickets
#   DEMO_GIT_TOKEN a token that may create issues there (GitHub: fine-grained, Issues read and write; Forgejo: write:issue)
DEMO_GIT_TYPE=forgejo
DEMO_GIT_URL=
DEMO_REPO=
DEMO_GIT_TOKEN=
# Written by ./setup.sh from the four settings above.
ALERT_INTAKE_HOSTS=
# Where the alert intake's source is (a checkout of the dev-foundry-alert-intake repository).
ALERT_INTAKE_SOURCE=../dev-foundry-alert-intake
